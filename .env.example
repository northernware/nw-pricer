# Copy to .env and fill in values. Required in production (no dev fallbacks).

# PostgreSQL connection string (Prisma)
DATABASE_URL=

# Session signing (required in production)
JWT_SECRET=
# Legacy alias (optional if JWT_SECRET is set)
AUTH_SECRET=

# Admin login password (required in production)
CRM_PASSWORD=
# Legacy alias (optional if CRM_PASSWORD is set)
ADMIN_PASSWORD=

# Optional: receive marketing test emails (bulk "Send test" in admin)
CRM_TEST_EMAIL=

# Optional: transactional email (Resend)
RESEND_API_KEY=

# Optional: public link signing (default on in production). Set false for legacy open signing.
PUBLIC_LINK_SIGNING=

# Optional: payment links on public invoices (PayMongo)
PAYMONGO_SECRET_KEY=
