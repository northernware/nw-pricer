generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  prospect
  active
  retainer
  completed
  declined
}

enum ProjectStatus {
  lead
  quoted
  signed
}

enum EmailCampaignStatus {
  draft
  sent
}

model Client {
  id        String       @id @default(cuid())
  firstName String
  lastName  String
  company   String?
  email     String?
  phone     String?
  address   String?
  status          ClientStatus @default(prospect)
  marketingOptIn  Boolean      @default(false)
  projects        Project[]
  logs      ActivityLog[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Project {
  id           String        @id
  name         String
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status       ProjectStatus @default(lead)
  config       Json
  logs         ActivityLog[]

  approvedAt   DateTime?
  signedBy     String?
  ipAddress    String?
  userAgent    String?
  snapshotHash String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type      String
  action    String
  details   Json?
  createdAt DateTime @default(now())
}

model EmailTemplate {
  id        String          @id @default(cuid())
  name      String
  subject   String
  body      String
  category  String          @default("general")
  campaigns EmailCampaign[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model EmailCampaign {
  id          String              @id @default(cuid())
  name        String
  subject     String
  templateId  String?
  template    EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status      EmailCampaignStatus @default(draft)
  recipients  Int                 @default(0)
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
}
