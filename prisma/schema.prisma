generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id
  name      String
  client    String
  config    Json
  approvedAt   DateTime?
  signedBy     String?
  ipAddress    String?
  userAgent    String?
  snapshotHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
