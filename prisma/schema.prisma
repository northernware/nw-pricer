generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id
  name      String
  client    String
  config    Json
  approvedAt DateTime?
  signedBy  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
